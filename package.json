{
  "name": "@tankecho42/dsh-lark-bridge",
  "version": "0.1.0",
  "description": "DSH (DeepSeek Harness) Feishu/Lark bridge plugin - talk to your DSH agents from Feishu DM and group chats via long-connection event subscription",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tankecho42/dsh-lark-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/tankecho42/dsh-lark-bridge/issues"
  },
  "homepage": "https://github.com/tankecho42/dsh-lark-bridge#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "feishu",
    "lark",
    "bridge",
    "im-bridge",
    "chatbot"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "@larksuiteoapi/node-sdk": "^1.73.0"
